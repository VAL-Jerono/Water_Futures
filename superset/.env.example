# ==============================================================================
# Water Futures — Superset stack environment template
# Quick setup: see superset/SUPABASE_SETUP.md
#   cp superset/.env.example superset/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE — the data home
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Use the Session Pooler URI (port 5432, works over IPv4):
#   postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# URL-encode special chars in the password (@ -> %40, # -> %23, % -> %25).
# ------------------------------------------------------------------------------
# Option A — full URI (simplest, preferred):
# SUPABASE_DB_URI=postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Option B — individual parts (used only if SUPABASE_DB_URI is empty):
# SUPABASE_DB_HOST=aws-0-<REGION>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<PROJECT_REF>
# SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
# SUPABASE_DB_NAME=postgres

# NOTE: if neither A nor B is set, the stack falls back to its local Postgres
# container so you can still demo offline. Supabase remains the canonical
# data home the moment the URI is provided — the dashboard builder detects
# it automatically and points every dataset at Supabase.
